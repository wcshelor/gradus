     half D4. Tests voice separation and inherited key/meter/clef/tempo/
     direction context at the passage start. -->
<score-partwise version="3.1">
  <part-list>
    <score-part id="P1">
      <part-name>Piano</part-name>
    </score-part>
  </part-list>
